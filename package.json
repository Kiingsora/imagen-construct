{
  "name": "imagen-construct",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "dev:editor": "pnpm --filter @imagen-construct/editor dev",
    "dev:api": "uv --directory services/generation run uvicorn imagen_construct.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @imagen-construct/editor test:e2e",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  }
}
